{
  "name": "catcheez-backend",
  "version": "0.5.0",
  "private": true,
  "description": "Catcheez backend — M2+M4+indexer (永続化/認証/締切/オンチェーンindexer, NestJS). フィクションのプロトタイプ。",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "smoke": "node scripts/smoke.js",
    "test:scheduler": "node scripts/test-scheduler.js",
    "test:indexer": "node scripts/test-indexer.js",
    "signin": "node scripts/sign.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "js-sha3": "^0.9.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.12.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/sql.js": "^1.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
